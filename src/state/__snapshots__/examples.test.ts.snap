// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`welcome > converts without diagnostics 1`] = `
"<h1>Welcome to Compono</h1><p>Compono is <strong>Markdown</strong> with <em>components</em>. It writes semantic HTML and nothing else: no classes, no styles, no scripts.</p><h2>Markdown</h2><ul><li><strong>Bold</strong>, <em>italic</em> and <code>inline code</code></li><li><a href="https://github.com/umono-cms/compono">Links</a>, lists and quotes</li><li>Tables, code blocks and thematic breaks</li></ul><blockquote><p>Write the content once, show it with any theme.</p></blockquote><table><thead><tr><th scope="col">Write</th><th scope="col">Get</th></tr></thead><tbody><tr><td><code>**bold**</code></td><td><strong>bold</strong></td></tr><tr><td><code>*italic*</code></td><td><em>italic</em></td></tr></tbody></table><pre><code data-lang="js">console.log(&#34;Code blocks keep their language&#34;)
</code></pre><hr><h2>Components</h2><p>Define a component at the bottom of the source with <code>~</code>, then call it anywhere with <code>{{ }}</code>:</p><h3>Reusable</h3><p>Define it once, call it anywhere.</p><h3>Semantic</h3><p>Plain HTML that any theme can style.</p><p>Built-in components do what Markdown can&#39;t, like a link that opens in a new tab: <a href="https://github.com/umono-cms/compono" target="_blank" rel="noopener noreferrer">Compono on GitHub</a></p><p>Global components are given from outside the source (see the <strong>SIGNATURE</strong> tab), and the context injects data into the conversion (see <strong>Context</strong>):</p><p>Happy writing, <strong>Jane Doe</strong></p>"
`;
